# Copy these into Netlify: Project configuration > Environment variables. Never commit real values.

# At least 32 random characters. Generate one with:  openssl rand -hex 32
BIDDESK_SESSION_SECRET=

# One entry per estimator, separated by semicolons. Each code must be at least 12 characters.
# The name before "=" is what BidDesk records as "decided by".
BIDDESK_USERS=Jane Estimator=replace-with-a-long-code;Sam Estimator=another-long-code

# Optional spending caps (defaults shown)
# BIDDESK_PUBLIC_DAILY_LIMIT=25
# BIDDESK_VISITOR_HOURLY_LIMIT=3
# BIDDESK_VISITOR_DAILY_LIMIT=5
# BIDDESK_STAFF_DAILY_LIMIT=60
